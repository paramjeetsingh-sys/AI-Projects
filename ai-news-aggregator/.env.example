# ── AI News Aggregator — Environment Variables ────────────────────────────────
# Copy this file to .env and fill in your values.
# The .env file is gitignored; never commit real credentials.

# ── LLM API — pick at least one (Anthropic is tried first) ───────────────────
# Get your key at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Get your key at https://console.groq.com  (used if ANTHROPIC_API_KEY is absent)
# GROQ_API_KEY=gsk_...

# ── Email (required for daily mail) ───────────────────────────────────────────
# For Gmail: create an App Password at https://myaccount.google.com/apppasswords
# (2-Step Verification must be enabled on your Google account first)

EMAIL_FROM=you@gmail.com
EMAIL_PASSWORD=your_app_password_here
EMAIL_TO=you@gmail.com          # comma-separate for multiple recipients

# ── SMTP overrides (optional — defaults shown) ────────────────────────────────
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587

# Other providers:
#   Outlook / Hotmail:  SMTP_HOST=smtp.office365.com  SMTP_PORT=587
#   Yahoo Mail:         SMTP_HOST=smtp.mail.yahoo.com  SMTP_PORT=587
#   SendGrid:           SMTP_HOST=smtp.sendgrid.net    SMTP_PORT=587
#                       EMAIL_FROM=apikey  EMAIL_PASSWORD=<sendgrid_api_key>
