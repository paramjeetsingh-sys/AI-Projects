# AI News Aggregator — environment variables
# Copy this file to .env and fill in your values:
#   cp .env.template .env

# ── Groq API (for LLaMA summarization) ───────────────────────────────────────
# Get a free key at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
# Gmail users: create an App Password at https://myaccount.google.com/apppasswords
# (requires 2-Step Verification to be enabled on your account)
EMAIL_FROM=you@gmail.com
EMAIL_PASSWORD=your_app_password_here
EMAIL_TO=you@gmail.com

# Optional — override defaults (smtp.gmail.com:587)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
